{
  "manifest_version": 3,
  "name": "ColorGrax",
  "version": "1.0.0",
  "description": "Pick colors from webpages and view HEX, RGB, and Pantone color matches.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ColorGrax — Pick a Color"
  },
  "permissions": [
    "activeTab",
    "storage"
  ]
}
